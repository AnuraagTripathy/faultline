# Copy to .env.local (gitignored) and fill in OAuth credentials.
#   cp .env.local.example .env.local
#
# Register these redirect URIs with each provider:
#   http://localhost:3000/api/auth/oauth/google/callback
#   http://localhost:3000/api/auth/oauth/github/callback

# Use localhost — not 0.0.0.0 (browsers cannot open 0.0.0.0)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Console → OAuth 2.0 Client (Web application)
FAULTLINE_OAUTH_GOOGLE_CLIENT_ID=
FAULTLINE_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
FAULTLINE_OAUTH_GITHUB_CLIENT_ID=
FAULTLINE_OAUTH_GITHUB_CLIENT_SECRET=
