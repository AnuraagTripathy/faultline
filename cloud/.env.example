# Faultline Cloud API — copy to cloud/.env or pass via docker-compose / host env
# Do not commit real secrets.

# HTTP server (uvicorn)
# FAULTLINE_CLOUD_HOST=0.0.0.0
# FAULTLINE_CLOUD_PORT=8080

# SQLite database file path
FAULTLINE_CLOUD_DB=cloud/data/faultline.db

# Checkpoint filesystem root (local backend)
FAULTLINE_CLOUD_STORAGE=local
FAULTLINE_CLOUD_CHECKPOINTS_DIR=cloud/data/checkpoints

# JWT signing secret (required in production)
FAULTLINE_JWT_SECRET=change-me-in-production

# API version string returned by /health and /ready
FAULTLINE_CLOUD_VERSION=18.5

# Comma-separated browser origins for CORS (Next.js dev / Docker web)
FAULTLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev API key is seeded on first DB init as fl_dev_local (plaintext, local preview only)
