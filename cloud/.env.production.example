# Faultline Cloud API v24 production example
FAULTLINE_ENV=production
FAULTLINE_CLOUD_VERSION=24.0
FAULTLINE_DATABASE_URL=postgresql+psycopg://faultline:password@db-host:5432/faultline
FAULTLINE_CLOUD_STORAGE=s3
FAULTLINE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
FAULTLINE_S3_BUCKET=faultline-prod
FAULTLINE_S3_ACCESS_KEY=replace_me
FAULTLINE_S3_SECRET_KEY=replace_me
FAULTLINE_S3_REGION=auto
FAULTLINE_JWT_SECRET=replace_with_long_random_secret
FAULTLINE_COOKIE_SECURE=true
FAULTLINE_CORS_ORIGINS=https://app.faultline.dev

# Optional OAuth providers (browser login)
FAULTLINE_OAUTH_GOOGLE_CLIENT_ID=
FAULTLINE_OAUTH_GOOGLE_CLIENT_SECRET=
FAULTLINE_OAUTH_GITHUB_CLIENT_ID=
FAULTLINE_OAUTH_GITHUB_CLIENT_SECRET=

FAULTLINE_RATE_LIMIT_ENABLED=true
FAULTLINE_RATE_LIMIT_REQUESTS_PER_MINUTE=120
FAULTLINE_RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
FAULTLINE_RATE_LIMIT_UPLOADS_PER_MINUTE=10

# Do NOT set in production:
# FAULTLINE_SEED_DEMO=1
