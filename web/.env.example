# Faultline Cloud web (Next.js) — copy to web/.env.local for npm run dev
# In Docker Compose these are set in docker-compose.cloud.yml

# Server-only: BFF → FastAPI (never exposed to the browser)
FAULTLINE_API_URL=http://127.0.0.1:8080
FAULTLINE_API_KEY=fl_dev_local

# Docker Compose internal URL example:
# FAULTLINE_API_URL=http://cloud-api:8080

# Optional: public URL of this web app (for future links / OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (browser only)
# Set in API environment, not in the browser bundle.
# FAULTLINE_OAUTH_GOOGLE_CLIENT_ID=
# FAULTLINE_OAUTH_GOOGLE_CLIENT_SECRET=
# FAULTLINE_OAUTH_GITHUB_CLIENT_ID=
# FAULTLINE_OAUTH_GITHUB_CLIENT_SECRET=
